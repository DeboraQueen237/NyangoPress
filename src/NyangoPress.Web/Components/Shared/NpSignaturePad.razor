@using MudBlazor
@inject IJSRuntime JS
@inject LanguageService L

<div>
    <div class="d-flex justify-space-between align-center mb-1">
        <MudText Typo="Typo.subtitle2">@Label</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearAsync">
            @(L.IsFrench ? "Effacer" : "Clear")
        </MudButton>
    </div>
    <canvas id="@_canvasId" class="np-signature-canvas"></canvas>
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        @(L.IsFrench ? "Signez avec le doigt, le stylet ou la souris ci-dessus." : "Sign with finger, stylus or mouse above.")
    </MudText>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Signature du client";
    private readonly string _canvasId = $"sig-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("nyangoPress.signaturePad.init", _canvasId);
        }
    }

    public async Task ClearAsync()
        => await JS.InvokeVoidAsync("nyangoPress.signaturePad.clear", _canvasId);

    public async Task<string?> CaptureDataUrlAsync()
        => await JS.InvokeAsync<string?>("nyangoPress.signaturePad.getDataUrl", _canvasId);
}
