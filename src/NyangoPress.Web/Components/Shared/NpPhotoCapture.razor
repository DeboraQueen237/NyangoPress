@using MudBlazor
@inject IJSRuntime JS
@inject LanguageService L

<div>
    <div class="d-flex flex-wrap gap-2 align-center mb-2">
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="OnFilesSelected" Accept="image/*" MaximumFileCount="5">
            <CustomContent Context="fileUpload">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAPhoto" Size="Size.Small" OnClick="@fileUpload.OpenFilePickerAsync">
                    @(L.IsFrench ? "Importer photos" : "Upload photos")
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" OnClick="ToggleCameraAsync">
            @(_cameraOpen ? (L.IsFrench ? "Fermer caméra" : "Close camera") : (L.IsFrench ? "Prendre photo (caméra)" : "Take photo (camera)"))
        </MudButton>
    </div>

    @if (_cameraOpen)
    {
        <MudPaper Elevation="1" Class="pa-2 mb-2 rounded-lg">
            <video id="@_videoId" autoplay playsinline style="width:100%;max-height:220px;border-radius:8px;background:#000;"></video>
            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CaptureFromCameraAsync">
                    @(L.IsFrench ? "Capturer" : "Capture")
                </MudButton>
            </div>
        </MudPaper>
    }

    @if (Photos.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 mt-2">
            @for (var i = 0; i < Photos.Count; i++)
            {
                var idx = i;
                <div style="position:relative;">
                    <img src="@Photos[idx]" alt="Photo" style="width:76px;height:76px;object-fit:cover;border-radius:8px;border:1px solid #cbd5e1;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                   Style="position:absolute;top:-8px;right:-8px;background:#fff;"
                                   OnClick="@(() => RemoveAtAsync(idx))" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<string> Photos { get; set; } = [];
    [Parameter] public EventCallback<List<string>> PhotosChanged { get; set; }

    private readonly string _videoId = $"cam-{Guid.NewGuid():N}";
    private bool _cameraOpen;

    private async Task OnFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files.Take(5 - Photos.Count))
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            Photos.Add($"data:{file.ContentType};base64,{b64}");
        }
        await PhotosChanged.InvokeAsync(Photos);
    }

    private async Task ToggleCameraAsync()
    {
        if (_cameraOpen)
        {
            await JS.InvokeVoidAsync("nyangoPress.camera.stop");
            _cameraOpen = false;
        }
        else
        {
            _cameraOpen = true;
            StateHasChanged();
            await Task.Delay(50);
            await JS.InvokeAsync<bool>("nyangoPress.camera.start", _videoId);
        }
    }

    private async Task CaptureFromCameraAsync()
    {
        var dataUrl = await JS.InvokeAsync<string?>("nyangoPress.camera.capture", _videoId);
        if (!string.IsNullOrWhiteSpace(dataUrl))
        {
            Photos.Add(dataUrl);
            await PhotosChanged.InvokeAsync(Photos);
        }
    }

    private async Task RemoveAtAsync(int idx)
    {
        if (idx >= 0 && idx < Photos.Count)
        {
            Photos.RemoveAt(idx);
            await PhotosChanged.InvokeAsync(Photos);
        }
    }
}
