@inherits LayoutComponentBase
@using NyangoPress.Web.Theme

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Class="np-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <a href="/" class="np-brand ml-2">
            <NpLogo />
            <span class="np-brand-name">NyangoPress</span>
        </a>
        <MudSpacer />
        @* TODO : NpLanguageSwitcher quand le composant sera prêt *@
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudNavMenu Class="np-nav">
            @* Provisoire : à remplacer par les NavItems des modules et les textes i18n *@
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Accueil</MudNavLink>
            <MudNavLink Href="/caisse" Icon="@Icons.Material.Filled.PointOfSale">Caisse</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.ViewKanban">Production</MudNavLink>
            <MudNavLink Disabled="true" Icon="@Icons.Material.Filled.Dashboard">Tableau de bord</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 np-bottom-nav-space">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    @* TODO : texte via les ressources FR/EN *@
    <a href="" class="reload">↻</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private readonly MudTheme _theme = NyangoPressTheme.Create();
    private bool _isDarkMode;
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;
}
