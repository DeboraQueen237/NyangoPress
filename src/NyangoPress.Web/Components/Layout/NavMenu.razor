@implements IDisposable
@inject AuthSessionService Session
@inject LanguageService L

<div class="pa-4 d-flex flex-column align-center" style="border-bottom:1px solid rgba(255,255,255,0.12);">
    <img src="/branding/logo-full.svg" alt="NyangoPress" style="max-width:190px;background:#fff;padding:6px 10px;border-radius:10px;" />
    @if (Session.IsAuthenticated)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled" Class="mt-2">
            @Session.Role · @Session.CurrentUser!.DisplayName
        </MudChip>
    }
</div>

<MudNavMenu Class="py-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@L.T("Nav.Home")</MudNavLink>

    @if (!Session.IsAuthenticated || Session.HasAnyRole(Roles.Admin, Roles.Manager, Roles.Cashier))
    {
        <MudNavGroup Title="@(L.IsFrench ? "Caisse & Commandes" : "POS & Orders")" Icon="@Icons.Material.Filled.PointOfSale" Expanded="true">
            <MudNavLink Href="/orders/new" Icon="@Icons.Material.Filled.AddCircleOutline">@L.T("Nav.NewOrder")</MudNavLink>
            <MudNavLink Href="/orders" Icon="@Icons.Material.Filled.ReceiptLong">@L.T("Nav.Orders")</MudNavLink>
            <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.People">@L.T("Nav.Customers")</MudNavLink>
        </MudNavGroup>
    }

    @if (!Session.IsAuthenticated || Session.HasAnyRole(Roles.Admin, Roles.Manager, Roles.Cashier, Roles.Operator))
    {
        <MudNavGroup Title="@(L.IsFrench ? "Atelier & Stockage" : "Production & Storage")" Icon="@Icons.Material.Filled.PrecisionManufacturing" Expanded="true">
            <MudNavLink Href="/production" Icon="@Icons.Material.Filled.ViewKanban">@L.T("Nav.Production")</MudNavLink>
            <MudNavLink Href="/storage" Icon="@Icons.Material.Filled.Inventory2">@L.T("Nav.Storage")</MudNavLink>
        </MudNavGroup>
    }

    @if (!Session.IsAuthenticated || Session.HasAnyRole(Roles.Admin, Roles.Manager, Roles.Cashier, Roles.Driver))
    {
        <MudNavGroup Title="@(L.IsFrench ? "Livraison & Collecte" : "Delivery & Pickup")" Icon="@Icons.Material.Filled.LocalShipping" Expanded="true">
            @if (!Session.IsAuthenticated || Session.HasAnyRole(Roles.Admin, Roles.Manager, Roles.Cashier))
            {
                <MudNavLink Href="/delivery" Icon="@Icons.Material.Filled.Route">@L.T("Nav.Delivery")</MudNavLink>
            }
            <MudNavLink Href="/driver" Icon="@Icons.Material.Filled.TwoWheeler">@L.T("Nav.Driver")</MudNavLink>
        </MudNavGroup>
    }

    @if (!Session.IsAuthenticated || Session.HasAnyRole(Roles.Admin, Roles.Manager))
    {
        <MudNavLink Href="/auctions" Icon="@Icons.Material.Filled.Gavel">@L.T("Nav.Auctions")</MudNavLink>
    }

    <MudDivider Class="my-2" Style="border-color:rgba(255,255,255,0.12);" />
    <MudNavLink Href="/suivi" Icon="@Icons.Material.Filled.TrackChanges">@L.T("Nav.PublicPortal")</MudNavLink>
    <MudNavLink Href="/login" Icon="@Icons.Material.Filled.SwitchAccount">@L.T("Nav.Login")</MudNavLink>
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += HandleStateChanged;
        L.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= HandleStateChanged;
        L.OnChange -= HandleStateChanged;
    }
}
