@page "/"
@layout PublicLayout
@using NyangoPress.Web.Components.Layout

<PageTitle>NyangoPress</PageTitle>

@* Provisoire : textes à passer dans les ressources FR/EN. *@
<section class="np-section np-hero-grid">
    <div>
        <MudText Typo="Typo.h1" GutterBottom="true">Vos vêtements méritent le meilleur soin.</MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-6">
            Lavage, repassage, nettoyage à sec et livraison à domicile, avec un suivi à chaque étape.
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3">
            <MudButton Href="/services" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Découvrir nos services</MudButton>
            @* TODO : lier à la demande de collecte (DEL-07) quand elle existera *@
            <MudButton Href="/contact" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large">Réserver maintenant</MudButton>
        </MudStack>
    </div>
    <div class="np-hero-tile" aria-hidden="true">
        <NpLogo Size="150" />
    </div>
</section>

@* Les étiquettes suspendues au rail mènent chacune vers sa page *@
<div class="np-rail">
    <div class="np-rail-track" role="list">
        @for (var i = 0; i < _links.Length; i++)
        {
            var l = _links[i];
            <a class="np-tag np-tag-wide" href="@l.Href" role="listitem" style="--tag:@l.Color; --i:@i; text-decoration:none">
                <span class="np-tag-string"></span>
                <span class="np-tag-hole"></span>
                <span class="np-tag-label">@l.Label</span>
                <span class="np-tag-text">@l.Text</span>
            </a>
        }
    </div>
</div>

@code {
    private record Entry(string Label, string Text, string Href, string Color);

    private static readonly Entry[] _links =
    {
        new("Nos services", "Lavage, repassage, nettoyage à sec.", "/services", "#0E7490"),
        new("Tarifs", "Nos prix, simplement.", "/tarifs", "#F4B942"),
        new("À propos", "Comment ça marche.", "/apropos", "#19B5C6"),
        new("Contact", "Où nous trouver.", "/contact", "#16A34A")
    };
}
