{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NyangoPress",
    "Audience": "NyangoPress.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7162", "http://localhost:5263" ]
  },
  "Storage": {
    "RootPath": "storage",
    "MaxFileBytes": 5242880
  },
  "Account": {
    "ExposeTemporaryPassword": false
  },
  "Database": {
    "AutoMigrate": false
  }
}
